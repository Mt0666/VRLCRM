@model Order
@using VRLCRM.Domain.Enums
@{
  ViewData["Title"] = "Sipariş Detayı";
  var canEdit = Model.IsActive && Model.Status == OrderStatus.Approved && !Model.SalesInvoiceId.HasValue;
}

<div class="row g-6">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
          <div>
            <h5 class="mb-1">@Model.OrderNumber</h5>
            <small class="text-body-secondary">@(Model.Customer?.FullName ?? Model.Supplier?.CompanyName ?? "-")</small>
          </div>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <partial name="_DocumentExportButtons" view-data='@(new ViewDataDictionary(ViewData) {
              ["PdfExportUrl"] = Url.Action("ExportPdf", new { id = Model.Id }),
              ["ExcelExportUrl"] = Url.Action("ExportExcel", new { id = Model.Id })
            })' />
            <button id="page-tour-btn" class="btn btn-sm btn-outline-secondary" title="Sayfayı Tanı">
              <i class="ri-question-line"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
              <i class="ri-arrow-left-line me-1"></i>Listeye Dön
            </a>
          </div>
        </div>
        @if (Model.IsActive && Model.Status == OrderStatus.Approved && !Model.SalesInvoiceId.HasValue)
        {
          <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
            <form asp-action="ConvertToSalesInvoice" asp-route-id="@Model.Id" method="post">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-primary btn-sm">
                <i class="ri-file-text-line me-1"></i>Satış Faturasına Dönüştür
              </button>
            </form>
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Sipariş silinecek. Devam edilsin mi?');">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="ri-delete-bin-6-line me-1"></i>Sil
              </button>
            </form>
          </div>
        }
      </div>
      <div class="card-body">
        <div class="detail-info-strip">
          <div class="detail-info-item">
            <div class="detail-info-label">Tarih</div>
            <div class="detail-info-value">@Model.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
          </div>
          <div class="detail-info-item">
            <div class="detail-info-label">Sipariş Durumu</div>
            <div class="detail-info-value d-flex flex-wrap align-items-center gap-2">
              <partial name="_OrderStatusBadge" model="Model" />
              @if (Model.SalesInvoiceId.HasValue && Model.SalesInvoice is not null)
              {
                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.SalesInvoiceId">@Model.SalesInvoice.InvoiceNumber</a>
              }
            </div>
          </div>
          <div class="detail-info-item">
            <div class="detail-info-label">Genel Toplam</div>
            <div class="detail-info-value">@Model.TotalAmount.ToString("N2") ₺</div>
          </div>
          <div class="detail-info-item">
            <div class="detail-info-label">Kayıt Durumu</div>
            <div class="detail-info-value"><partial name="_StatusBadge" model="Model.IsActive" /></div>
          </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
          <p class="mb-4 text-body-secondary"><i class="ri-sticky-note-line me-1"></i>@Model.Notes</p>
        }

        @if (canEdit)
        {
          var partyType = ViewBag.PartyType as string ?? (Model.SupplierId.HasValue ? "supplier" : "customer");
          var customers = ViewBag.Customers as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
          var suppliers = ViewBag.Suppliers as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
          <form asp-action="Update" asp-route-id="@Model.Id" method="post" id="orderEditForm">
            @Html.AntiForgeryToken()

            <div class="card border mb-4">
              <div class="card-header py-2">
                <span class="fw-semibold small"><i class="ri-user-line me-1"></i>Cari Hesap</span>
              </div>
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-md-12">
                    <label class="form-label">Cari Türü</label>
                    <div class="d-flex gap-3">
                      <div class="form-check">
                        <input class="form-check-input" type="radio" name="PartyType" id="partyCustomer" value="customer" checked="@(partyType != "supplier")" />
                        <label class="form-check-label" for="partyCustomer">Müşteri</label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="radio" name="PartyType" id="partySupplier" value="supplier" checked="@(partyType == "supplier")" />
                        <label class="form-check-label" for="partySupplier">Tedarikçi</label>
                      </div>
                    </div>
                    <small class="text-body-secondary">Yanlış cariye kestiyseniz buradan değiştirebilirsiniz.</small>
                  </div>
                  <div class="col-md-6" id="customerSelectWrap">
                    <label class="form-label">Müşteri</label>
                    <select name="CustomerId" id="CustomerId" class="form-select select2">
                      <option value="">Müşteri seçin</option>
                      @foreach (var item in customers)
                      {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                      }
                    </select>
                  </div>
                  <div class="col-md-6" id="supplierSelectWrap" style="display:none;">
                    <label class="form-label">Tedarikçi</label>
                    <select name="SupplierId" id="SupplierId" class="form-select select2">
                      <option value="">Tedarikçi seçin</option>
                      @foreach (var item in suppliers)
                      {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                      }
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="card border mb-4">
              <div class="card-header py-2">
                <span class="fw-semibold small"><i class="ri-add-circle-line me-1"></i>Ürün Ekle</span>
              </div>
              <div class="card-body">
                <div class="row g-3 align-items-center">
                  <div class="col-md-5">
                    <select id="productSelect" style="width:100%">
                      <option value=""></option>
                    </select>
                    <div id="productMessage" class="form-text text-danger mt-1"></div>
                    <div id="productPreview" class="form-text mt-1" style="display:none;">
                      <span id="previewStock"></span>
                      <span class="mx-2 text-body-secondary">|</span>
                      <span id="previewPrice"></span>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <input type="number" id="scanQty" class="form-control" value="1" min="1" placeholder="Adet" />
                  </div>
                  <div class="col-md-2">
                    <input type="number" id="lineUnitPrice" class="form-control" step="0.01" min="0" placeholder="Satış Fiyatı" />
                  </div>
                  <div class="col-md-3">
                    <button type="button" id="addProductBtn" class="btn btn-primary w-100">
                      <i class="ri-add-line me-1"></i>Ekle
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-none d-md-block table-responsive mb-0">
              <table class="table table-bordered table-sm align-middle js-lines-table" id="linesTable">
                <thead class="table-light">
                  <tr>
                    <th>Ürün</th>
                    <th>Açıklama</th>
                    <th class="text-center" style="width:80px">Adet</th>
                    <th class="text-end" style="width:130px">Birim Fiyat</th>
                    <th class="text-end js-discount-col d-none" style="width:140px">İskontolu B. Fiyat</th>
                    <th class="text-center" style="width:80px">KDV %</th>
                    <th class="text-end" style="width:120px">KDV Tutarı</th>
                    <th class="text-end" style="width:130px">Toplam</th>
                    <th style="width:50px"></th>
                  </tr>
                </thead>
                <tbody id="linesBody"></tbody>
              </table>
            </div>
            <div class="d-md-none" id="orderLinesMobile"></div>
            <div class="d-flex justify-content-end mt-2">
              <div class="order-totals-card">
                <div class="order-totals-row">
                  <span>Ara Toplam</span>
                  <span id="subTotal">@Model.SubTotal.ToString("N2") ₺</span>
                </div>
                <div class="order-totals-row">
                  <span>Toplam KDV</span>
                  <span id="vatTotal">@Model.VatTotal.ToString("N2") ₺</span>
                </div>
                <div class="order-totals-row align-items-center gap-2">
                  <span>Sipariş İskontosu (%)</span>
                  <input type="number" id="orderDiscountRate" name="DiscountRate" class="form-control form-control-sm text-end"
                         value="@Model.DiscountRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" max="100" step="0.01" style="width:110px" />
                </div>
                <div class="order-totals-row" id="discountAmountRow" style="@(Model.DiscountRate > 0 ? "" : "display:none;")">
                  <span>İskonto Tutarı</span>
                  <span id="discountAmount">@Model.DiscountAmount.ToString("N2") ₺</span>
                </div>
                <div class="order-totals-grand">
                  <span>Genel Toplam</span>
                  <span id="grandTotal">@Model.TotalAmount.ToString("N2") ₺</span>
                </div>
              </div>
            </div>
            <div id="lineInputs"></div>
            <div class="mt-3">
              <button type="submit" class="btn btn-primary btn-sm">
                <i class="ri-save-line me-1"></i>Değişiklikleri Kaydet
              </button>
            </div>
          </form>
        }
        else
        {
          // İskonto tüm satırlara aynı oranda uygulandığı için net birim fiyat = fiyat × (1 - oran/100).
          var discountFactor = 1m - Math.Min(Math.Max(Model.DiscountRate, 0m), 100m) / 100m;
          <div class="d-none d-md-block table-responsive mb-0">
            <table class="table table-bordered table-sm align-middle js-lines-table">
              <thead class="table-light">
                <tr>
                  <th>Ürün</th>
                  <th>Açıklama</th>
                  <th class="text-center" style="width:80px">Adet</th>
                  <th class="text-end" style="width:130px">Birim Fiyat</th>
                  @if (Model.DiscountRate > 0)
                  {
                    <th class="text-end" style="width:140px">İskontolu B. Fiyat</th>
                  }
                  <th class="text-center" style="width:80px">KDV %</th>
                  <th class="text-end" style="width:120px">KDV Tutarı</th>
                  <th class="text-end" style="width:130px">Toplam</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var line in Model.Lines)
                {
                  <tr>
                    <td>@line.StockItem.Name</td>
                    <td class="small text-body-secondary">@(line.Notes ?? "-")</td>
                    <td class="text-center">@line.Quantity</td>
                    <td class="text-end">@line.UnitPrice.ToString("N2") ₺</td>
                    @if (Model.DiscountRate > 0)
                    {
                      <td class="text-end fw-semibold">@((line.UnitPrice * discountFactor).ToString("N2")) ₺</td>
                    }
                    <td class="text-center">%@line.VatRate.ToString("N0")</td>
                    <td class="text-end">@line.VatAmount.ToString("N2") ₺</td>
                    <td class="text-end fw-semibold">@line.LineTotal.ToString("N2") ₺</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="d-md-none">
            @foreach (var line in Model.Lines)
            {
              <div class="card order-line-mobile-card mb-3">
                <div class="card-body p-3">
                  <div class="mb-3">
                    <div class="order-line-mobile-label">Ürün</div>
                    <div class="fw-semibold">@line.StockItem.Name</div>
                  </div>
                  <div class="mb-3">
                    <div class="order-line-mobile-label">Açıklama</div>
                    <div class="text-body-secondary">@(line.Notes ?? "-")</div>
                  </div>
                  <div class="order-line-mobile-row">
                    <span class="order-line-mobile-label">Adet</span>
                    <span>@line.Quantity</span>
                  </div>
                  <div class="order-line-mobile-row">
                    <span class="order-line-mobile-label">Birim Fiyat</span>
                    <span>@line.UnitPrice.ToString("N2") ₺</span>
                  </div>
                  @if (Model.DiscountRate > 0)
                  {
                    <div class="order-line-mobile-row">
                      <span class="order-line-mobile-label">İskontolu B. Fiyat</span>
                      <span class="fw-semibold">@((line.UnitPrice * discountFactor).ToString("N2")) ₺</span>
                    </div>
                  }
                  <div class="order-line-mobile-row">
                    <span class="order-line-mobile-label">KDV %</span>
                    <span>%@line.VatRate.ToString("N0")</span>
                  </div>
                  <div class="order-line-mobile-row">
                    <span class="order-line-mobile-label">KDV Tutarı</span>
                    <span>@line.VatAmount.ToString("N2") ₺</span>
                  </div>
                  <div class="order-line-mobile-row order-line-mobile-row-total">
                    <span class="order-line-mobile-label">Toplam</span>
                    <span class="fw-bold">@line.LineTotal.ToString("N2") ₺</span>
                  </div>
                </div>
              </div>
            }
          </div>

          <div class="d-flex justify-content-end mt-2">
            <div class="order-totals-card">
              <div class="order-totals-row">
                <span>Ara Toplam</span>
                <span>@Model.SubTotal.ToString("N2") ₺</span>
              </div>
              <div class="order-totals-row">
                <span>Toplam KDV</span>
                <span>@Model.VatTotal.ToString("N2") ₺</span>
              </div>
              @if (Model.DiscountRate > 0)
              {
                <div class="order-totals-row">
                  <span>Sipariş İskontosu (%@Model.DiscountRate.ToString("N2"))</span>
                  <span>-@Model.DiscountAmount.ToString("N2") ₺</span>
                </div>
              }
              <div class="order-totals-grand">
                <span>Genel Toplam</span>
                <span>@Model.TotalAmount.ToString("N2") ₺</span>
              </div>
            </div>
          </div>
        }
      </div>
    </div>
  </div>
</div>

@section PageStyles {
<style>
  .order-line-mobile-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bs-secondary-color);
  }
  .order-line-mobile-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--bs-border-color-translucent);
  }
  .order-line-mobile-row-total {
    border-bottom: none;
    padding-top: 0.25rem;
  }
</style>
}

@section PageScripts {
@if (canEdit)
{
<script>
(function () {
  function toggleOrderParty() {
    var isSupplier = document.getElementById('partySupplier').checked;
    document.getElementById('customerSelectWrap').style.display = isSupplier ? 'none' : '';
    document.getElementById('supplierSelectWrap').style.display = isSupplier ? '' : 'none';
    if (isSupplier) {
      var customerSelect = document.getElementById('CustomerId');
      if (customerSelect) customerSelect.value = '';
    } else {
      var supplierSelect = document.getElementById('SupplierId');
      if (supplierSelect) supplierSelect.value = '';
    }
  }
  document.getElementById('partyCustomer').addEventListener('change', toggleOrderParty);
  document.getElementById('partySupplier').addEventListener('change', toggleOrderParty);
  toggleOrderParty();

  const productCache = new Map();

  function fmtMoney(v) {
    return parseFloat(v).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';
  }

  function updateProductPreview(product) {
    var preview = document.getElementById('productPreview');
    if (!preview) return;
    if (!product) {
      preview.style.display = 'none';
      return;
    }
    preview.style.display = '';
    var qty = product.stockQuantity != null ? product.stockQuantity : 0;
    document.getElementById('previewStock').innerHTML =
      'Stok: <strong>' + qty + '</strong> adet';
    document.getElementById('previewPrice').innerHTML =
      'Birim fiyat: <strong>' + fmtMoney(product.price) + '</strong>';
  }

  function formatProductOption(item) {
    var qty = item.stockQuantity != null ? item.stockQuantity : 0;
    return item.name +
      (item.stockCode ? ' (' + item.stockCode + ')' : '') +
      ' · Stok: ' + qty + ' · ' + fmtMoney(item.price);
  }

  const initialLines = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lines.Select(l => new {
    stockId = l.StockItemId.ToString(),
    name = l.StockItem.Name,
    qty = l.Quantity,
    price = l.UnitPrice,
    vatRate = l.VatRate,
    notes = l.Notes ?? ""
  })));

  let lineIndex = 0;
  const lines = new Map();
  initialLines.forEach(function(item) {
    lines.set(item.stockId, {
      name: item.name,
      qty: item.qty,
      price: item.price,
      vatRate: item.vatRate,
      notes: item.notes
    });
  });

  function updateTotals() {
    let sub = 0, vat = 0;
    lines.forEach(function(item) {
      const lineSub = item.qty * item.price;
      vat += lineSub * (item.vatRate / 100);
      sub += lineSub;
    });
    const rate = parseFloat(document.getElementById('orderDiscountRate').value) || 0;
    const gross = sub + vat;
    const discountAmt = gross * (Math.min(Math.max(rate, 0), 100) / 100);
    const grand = gross - discountAmt;
    const fmt = function(v) { return v.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺'; };
    document.getElementById('subTotal').textContent = fmt(sub);
    document.getElementById('vatTotal').textContent = fmt(vat);
    document.getElementById('grandTotal').textContent = fmt(grand);
    var discountRow = document.getElementById('discountAmountRow');
    if (rate > 0) {
      discountRow.style.display = '';
      document.getElementById('discountAmount').textContent = fmt(discountAmt);
    } else {
      discountRow.style.display = 'none';
    }
    syncDiscountColumn();
  }

  // ── İskontolu birim fiyat kolonu ──────────────────────────────────────
  // İskonto tüm satırlara aynı oranda uygulandığı için net birim fiyat = fiyat × (1 - oran/100).
  function syncDiscountColumn() {
    const rate = parseFloat(document.getElementById('orderDiscountRate').value) || 0;
    const show = rate > 0;
    document.querySelectorAll('.js-discount-col').forEach(function(el) {
      el.classList.toggle('d-none', !show);
    });
    if (!show) return;
    const factor = 1 - Math.min(Math.max(rate, 0), 100) / 100;
    document.querySelectorAll('[data-stock-id]').forEach(function(host) {
      const item = lines.get(host.dataset.stockId);
      const cell = host.querySelector('.line-discounted');
      if (item && cell) cell.textContent = fmtMoney(item.price * factor);
    });
  }

  function rebuildHiddenInputs() {
    const container = document.getElementById('lineInputs');
    container.innerHTML = '';
    lineIndex = 0;
    lines.forEach(function(item, stockId) {
      container.insertAdjacentHTML('beforeend',
        '<input type="hidden" name="Lines[' + lineIndex + '].StockItemId" value="' + stockId + '" />' +
        '<input type="hidden" name="Lines[' + lineIndex + '].StockName" value="' + item.name.replace(/"/g, '&quot;') + '" />' +
        '<input type="hidden" name="Lines[' + lineIndex + '].Quantity" value="' + item.qty + '" />' +
        '<input type="hidden" name="Lines[' + lineIndex + '].UnitPrice" value="' + item.price + '" />' +
        '<input type="hidden" name="Lines[' + lineIndex + '].VatRate" value="' + item.vatRate + '" />' +
        '<input type="hidden" name="Lines[' + lineIndex + '].Notes" value="' + (item.notes || '').replace(/"/g, '&quot;') + '" />');
      lineIndex++;
    });
  }

  function syncLineViews(stockId) {
    const item = lines.get(stockId);
    if (!item) return;
    const fmt = function(v) { return v.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺'; };
    const vatText = fmt(item.qty * item.price * (item.vatRate / 100));
    const totalText = fmt(item.qty * item.price * (1 + item.vatRate / 100));
    document.querySelectorAll('[data-stock-id="' + stockId + '"] .line-vat').forEach(function(el) {
      el.textContent = vatText;
    });
    document.querySelectorAll('[data-stock-id="' + stockId + '"] .line-total').forEach(function(el) {
      el.textContent = totalText;
    });
    document.querySelectorAll('[data-stock-id="' + stockId + '"] .line-qty').forEach(function(el) {
      if (document.activeElement !== el) el.value = item.qty;
    });
    document.querySelectorAll('[data-stock-id="' + stockId + '"] .line-price').forEach(function(el) {
      if (document.activeElement !== el) el.value = item.price.toFixed(2);
    });
    document.querySelectorAll('[data-stock-id="' + stockId + '"] .line-vat').forEach(function(el) {
      if (document.activeElement !== el) el.value = item.vatRate;
    });
    rebuildHiddenInputs();
    updateTotals();
  }

  function bindLineEvents(root, stockId) {
    const item = lines.get(stockId);
    root.querySelectorAll('.line-qty').forEach(function(input) {
      input.addEventListener('change', function() {
        const qty = parseInt(this.value, 10);
        if (!qty || qty <= 0) { this.value = item.qty; return; }
        item.qty = qty;
        syncLineViews(stockId);
      });
    });
    root.querySelectorAll('.line-price').forEach(function(input) {
      input.addEventListener('change', function() {
        const price = parseFloat(this.value);
        if (isNaN(price) || price < 0) { this.value = item.price.toFixed(2); return; }
        item.price = price;
        syncLineViews(stockId);
      });
    });
    root.querySelectorAll('.line-vat').forEach(function(input) {
      input.addEventListener('change', function() {
        const vatRate = parseFloat(this.value);
        if (isNaN(vatRate) || vatRate < 0 || vatRate > 100) { this.value = item.vatRate; return; }
        item.vatRate = vatRate;
        syncLineViews(stockId);
      });
    });
    root.querySelectorAll('.line-notes').forEach(function(input) {
      input.addEventListener('input', function() {
        item.notes = this.value;
        document.querySelectorAll('[data-stock-id="' + stockId + '"] .line-notes').forEach(function(el) {
          if (el !== input) el.value = item.notes;
        });
        rebuildHiddenInputs();
      });
    });
    root.querySelectorAll('.remove-line').forEach(function(button) {
      button.addEventListener('click', function() {
        lines.delete(stockId);
        renderLines();
        rebuildHiddenInputs();
        updateTotals();
      });
    });
  }

  function renderLines() {
    const tbody = document.getElementById('linesBody');
    const mobile = document.getElementById('orderLinesMobile');
    tbody.innerHTML = '';
    mobile.innerHTML = '';
    const fmt = function(v) { return v.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺'; };

    lines.forEach(function(item, stockId) {
      const row = document.createElement('tr');
      row.dataset.stockId = stockId;
      row.innerHTML =
        '<td>' + item.name + '</td>' +
        '<td><input type="text" class="form-control form-control-sm line-notes" value="' + (item.notes || '').replace(/"/g, '&quot;') + '" /></td>' +
        '<td class="text-center"><input type="number" class="form-control form-control-sm line-qty text-center" value="' + item.qty + '" min="1" style="width:70px;margin:0 auto;" /></td>' +
        '<td class="text-end" style="padding:4px 8px"><input type="number" class="form-control form-control-sm text-end line-price" value="' + item.price.toFixed(2) + '" step="0.01" min="0" style="width:110px;margin-left:auto" /></td>' +
        '<td class="text-end fw-semibold js-discount-col d-none line-discounted"></td>' +
        '<td class="text-center" style="padding:4px 8px"><input type="number" class="form-control form-control-sm text-center line-vat" value="' + item.vatRate + '" step="0.01" min="0" max="100" style="width:70px;margin:0 auto;" /></td>' +
        '<td class="text-end line-vat">' + fmt(item.qty * item.price * (item.vatRate / 100)) + '</td>' +
        '<td class="text-end fw-semibold line-total">' + fmt(item.qty * item.price * (1 + item.vatRate / 100)) + '</td>' +
        '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-line py-0 px-1"><i class="ri-delete-bin-6-line"></i></button></td>';
      bindLineEvents(row, stockId);
      tbody.appendChild(row);

      const card = document.createElement('div');
      card.className = 'card order-line-mobile-card mb-3';
      card.dataset.stockId = stockId;
      card.innerHTML =
        '<div class="card-body p-3">' +
          '<div class="d-flex justify-content-between align-items-start gap-2 mb-3">' +
            '<div class="flex-grow-1">' +
              '<div class="order-line-mobile-label">Ürün</div>' +
              '<div class="fw-semibold">' + item.name + '</div>' +
            '</div>' +
            '<button type="button" class="btn btn-sm btn-outline-danger remove-line flex-shrink-0"><i class="ri-delete-bin-6-line"></i></button>' +
          '</div>' +
          '<div class="mb-3">' +
            '<label class="order-line-mobile-label d-block mb-1">Açıklama</label>' +
            '<input type="text" class="form-control form-control-sm line-notes" value="' + (item.notes || '').replace(/"/g, '&quot;') + '" />' +
          '</div>' +
          '<div class="mb-3">' +
            '<label class="order-line-mobile-label d-block mb-1">Adet</label>' +
            '<input type="number" class="form-control form-control-sm line-qty" value="' + item.qty + '" min="1" style="max-width:120px;" />' +
          '</div>' +
          '<div class="mb-3">' +
            '<label class="order-line-mobile-label d-block mb-1">Birim Fiyat</label>' +
            '<input type="number" class="form-control form-control-sm line-price" value="' + item.price.toFixed(2) + '" step="0.01" min="0" style="max-width:140px;" />' +
          '</div>' +
          '<div class="mb-3">' +
            '<label class="order-line-mobile-label d-block mb-1">KDV %</label>' +
            '<input type="number" class="form-control form-control-sm line-vat" value="' + item.vatRate + '" step="0.01" min="0" max="100" style="max-width:120px;" />' +
          '</div>' +
          '<div class="order-line-mobile-row js-discount-col d-none"><span class="order-line-mobile-label">İskontolu B. Fiyat</span><span class="line-discounted fw-semibold"></span></div>' +
          '<div class="order-line-mobile-row"><span class="order-line-mobile-label">KDV Tutarı</span><span class="line-vat">' + fmt(item.qty * item.price * (item.vatRate / 100)) + '</span></div>' +
          '<div class="order-line-mobile-row order-line-mobile-row-total"><span class="order-line-mobile-label">Toplam</span><span class="line-total fw-bold">' + fmt(item.qty * item.price * (1 + item.vatRate / 100)) + '</span></div>' +
        '</div>';
      bindLineEvents(card, stockId);
      mobile.appendChild(card);
    });

    syncDiscountColumn();
  }

  document.getElementById('orderDiscountRate').addEventListener('input', updateTotals);

  var tsProduct = new TomSelect('#productSelect', {
    valueField: 'id',
    labelField: 'text',
    searchField: ['text', 'barcode'],
    create: false,
    loadThrottle: 300,
    shouldLoad: function(query) { return query.length > 0; },
    openOnFocus: false,
    placeholder: 'Ürün adı, kodu veya barkod ile arayın…',
    load: function(query, callback) {
      fetch('@Url.Action("SearchProduct", "Orders")' + '?term=' + encodeURIComponent(query))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          data.forEach(function(item) {
            productCache.set(String(item.id), item);
          });
          callback(data.map(function(item) {
            return {
              id: String(item.id),
              text: formatProductOption(item),
              barcode: item.barcode || ''
            };
          }));
        })
        .catch(function() { callback(); });
    },
    onChange: function(value) {
      var priceInput = document.getElementById('lineUnitPrice');
      if (value) {
        var product = productCache.get(String(value));
        if (product) {
          if (product.price != null) priceInput.value = parseFloat(product.price).toFixed(2);
          updateProductPreview(product);
        }
      } else {
        priceInput.value = '';
        updateProductPreview(null);
      }
    },
    onItemAdd: function() {
      setTimeout(function() {
        var qty = document.getElementById('scanQty');
        if (qty) { qty.focus(); qty.select(); }
      }, 50);
    }
  });

  // ── Donanım barkod okuyucu (klavye) — hızlı tarama + Enter'da tam barkod araması ──
  VRLBarcode.attachKeyboardWedge(tsProduct.control_input, {
    onScan: function (code) {
      var msg = document.getElementById('productMessage');
      if (msg) msg.textContent = '';
      VRLBarcode.lookup('@Url.Action("LookupBarcode", "Orders")', code).then(function (product) {
        if (!product) {
          tsProduct.setTextboxValue('');
          tsProduct.close();
          if (msg) msg.textContent = 'Barkod bulunamadı: ' + code;
          return;
        }
        var key = String(product.id);
        productCache.set(key, product);
        if (!tsProduct.options[key]) {
          tsProduct.addOption({
            id: key,
            text: product.name + (product.stockCode ? ' (' + product.stockCode + ')' : ''),
            barcode: product.barcode || ''
          });
        }
        tsProduct.setValue(key);
      });
    }
  });

  function addSelectedProduct() {
    var stockId = tsProduct.getValue();
    var qty = parseInt(document.getElementById('scanQty').value, 10) || 1;
    var customPrice = parseFloat(document.getElementById('lineUnitPrice').value);
    var msg = document.getElementById('productMessage');
    msg.textContent = '';
    if (!stockId) { msg.textContent = 'Lütfen ürün seçin.'; return; }
    var product = productCache.get(stockId);
    if (!product) { msg.textContent = 'Ürün bilgisi bulunamadı.'; return; }
    var finalPrice = (!isNaN(customPrice) && customPrice >= 0) ? customPrice : product.price;
    var existing = lines.get(stockId);
    lines.set(stockId, {
      name: product.name,
      qty: (existing ? existing.qty : 0) + qty,
      price: finalPrice,
      vatRate: product.vatRate,
      notes: existing ? existing.notes : ''
    });
    renderLines();
    rebuildHiddenInputs();
    updateTotals();
    tsProduct.clear();
    tsProduct.clearOptions();
    document.getElementById('scanQty').value = 1;
    document.getElementById('lineUnitPrice').value = '';
    updateProductPreview(null);
    setTimeout(function() { tsProduct.focus(); }, 80);
  }

  document.getElementById('addProductBtn').addEventListener('click', addSelectedProduct);
  document.getElementById('lineUnitPrice').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); addSelectedProduct(); }
  });

  renderLines();
  rebuildHiddenInputs();
  updateTotals();
})();
</script>
}
<script>
(function () {
  const d = window.driver && window.driver.js && window.driver.js.driver;
  if (!d) return;
  const tour = d({
    animate: true, smoothScroll: true, allowClose: true,
    overlayOpacity: 0.4, stagePadding: 6, stageRadius: 8,
    nextBtnText: 'İleri →', prevBtnText: '← Geri', doneBtnText: 'Tamam',
    showProgress: true, progressText: '{{current}} / {{total}}',
    steps: [
      { element: '.detail-info-strip', popover: { title: 'Sipariş Özeti', description: 'Sipariş tarihi, durumu, genel toplamı ve kayıt durumu. "Faturalandırıldı" çıkarsa ilgili fatura numarasına tıklayabilirsiniz.', side: 'bottom' } },
      { element: 'a[href*="ExportPdf"]', popover: { title: 'PDF İndir', description: 'Siparişi müşteriye göstermek veya arşivlemek için PDF olarak indirin.', side: 'bottom' } },
      { element: 'a[href*="ExportExcel"]', popover: { title: 'Excel İndir', description: 'Sipariş kalemlerini Excel formatında dışa aktarın.', side: 'bottom' } },
      { element: 'button[form*="ConvertToSalesInvoice"], form[action*="ConvertToSalesInvoice"] button', popover: { title: 'Satış Faturasına Dönüştür', description: 'Onaylanan sipariş hazırsa bu butona basarak otomatik satış faturası oluşturulur. Stok düşer, müşteri cari hesabı artar. Bu buton sadece onaylı ve henüz faturalanmamış siparişlerde görünür.', side: 'bottom' } },
      { element: 'form[action*="Cancel"] button', popover: { title: 'Siparişi İptal Et', description: 'Siparişi iptal eder. Onaylanmış siparişlerde stok ve cari hesap geri alınır. Bu işlem geri alınamaz, bir onay penceresi çıkar.', side: 'bottom' } },
      { element: '#linesTable, .js-lines-table', popover: { title: 'Sipariş Kalemleri', description: 'Siparişte yer alan ürünler, miktarlar ve birim fiyatlar. Bu liste fatura dönüştürüldüğünde aynen aktarılır.', side: 'top' } }
    ]
  });
  document.getElementById('page-tour-btn').addEventListener('click', () => tour.drive());
})();
</script>
}
