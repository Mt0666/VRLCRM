# --- Ofis offline HTTPS (local-https profili: Caddy + yerel DNS) ---
# Detayli akis: OFFLINE-HTTPS.md
# CRM adresi (Cloudflare'de bu zonun yonetildiginden emin ol)
CRM_HOSTNAME=crm.metevarol.com.tr
# Sunucunun SABIT LAN IP'si — telefonlar offline iken bu IP'ye baglanir
LOCAL_LAN_IP=
# Let's Encrypt (certbot) DNS-01 dogrulamasi icin — TUNNEL TOKEN'DAN AYRI
# Cloudflare > My Profile > API Tokens: Zone > DNS > Edit (sadece ilgili zone)
CLOUDFLARE_API_TOKEN=
# Sertifika bildirim e-postasi
ACME_EMAIL=admin@vrlcrm.local
